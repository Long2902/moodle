      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="mediaid" TYPE="foreign" FIELDS="mediaid" REFTABLE="local_digieramedia_media" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="mediaid" UNIQUE="true" FIELDS="mediaid"/>
        <INDEX NAME="purgeafter" UNIQUE="false" FIELDS="purgeafter"/>
      </INDEXES>
    </TABLE>

