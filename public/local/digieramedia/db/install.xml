      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="uploadid" TYPE="foreign" FIELDS="uploadid" REFTABLE="local_digieramedia_upload" REFFIELDS="id"/>
      </KEYS>
