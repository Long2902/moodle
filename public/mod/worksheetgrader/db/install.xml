        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true" />
        <FIELD NAME="course" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" />
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true" DEFAULT="" />
        <FIELD NAME="intro" TYPE="text" NOTNULL="false" />
        <FIELD NAME="introformat" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0" />
        <FIELD NAME="contenthtml" TYPE="text" NOTNULL="false" />
        <FIELD NAME="grade" TYPE="number" LENGTH="10" DECIMALS="5" NOTNULL="true" DEFAULT="10" />
        <FIELD NAME="aggregation" TYPE="char" LENGTH="12" NOTNULL="true" DEFAULT="average" />
        <FIELD NAME="allowgroup" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1" />
        <FIELD NAME="allowadjust" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1" />
        <FIELD NAME="representative" TYPE="char" LENGTH="12" NOTNULL="true" DEFAULT="anymember" />
        <FIELD NAME="completiononsubmit" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" />
        <FIELD NAME="completionongrade" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1" />
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" />
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" />
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id" />
        <KEY NAME="course" TYPE="foreign" FIELDS="course" REFTABLE="course" REFFIELDS="id" />
      </KEYS>
    </TABLE>
